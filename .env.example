# Copy to .env (git-ignored). Use PAPER keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=sip            # sip for history; iex for free live websocket

# Storage
DATA_ROOT=/mnt/nas/forecast/data        # Parquet store on TrueNAS
LOCAL_CACHE=/var/cache/forecast         # local NVMe copy of the active dataset

# Experiment services on k3s (reach over Tailscale or *.lan hostnames)
MLFLOW_TRACKING_URI=http://mlflow.lan.example:5000
OPTUNA_STORAGE=postgresql+psycopg://optuna:CHANGE_ME@postgres.lan.example:5432/optuna

# Worker identity (one per GPU machine)
WORKER_NAME=gpu-5070ti
WORKER_GPU_PROFILE=rtx5070ti            # matches configs/train/hardware.yaml
